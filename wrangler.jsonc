{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "postia",
  "main": ".open-next/worker.js",
  // 2026-08-04 or later turns nodejs_compat on by default; the flag stays explicit for readers.
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "postia" }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "postia.wearevision.cl", "custom_domain": true }],
  // Not a secret: the address LinkedIn sends the owner back to. Keys are Worker secrets (docs/despliegue.md).
  "vars": { "LINKEDIN_REDIRECT_URI": "https://postia.wearevision.cl/api/linkedin/callback" }
}
